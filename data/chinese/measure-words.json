  "rules": [
    {
      "title": "数字と名詞は直接つながらない",
      "body": "「3冊の本」は数字のあとに必ず量詞を入れます。量詞を抜かすのがいちばん多い間違いです。",
      "example": {
        "cn": "三本书",
        "pinyin": "sān běn shū",
        "ja": "3冊の本"
      }
    },
    {
      "title": "这・那・几・每のあとにも入る",
      "body": "「この・あの・いくつ」のあとにも量詞が必要です。数字がなくても省けません。",
      "example": {
        "cn": "这张票",
        "pinyin": "zhè zhāng piào",
        "ja": "このチケット"
      }
    },
    {
      "title": "「2つ」は二ではなく两",
      "body": "量詞の前に来る2は两を使います。二を使うのは番号や順番を言うときです。",
      "example": {
        "cn": "两个人",
        "pinyin": "liǎng ge rén",
        "ja": "2人"
      }
    },
    {
      "title": "迷ったら个でだいたい通じる",
      "body": "正しい量詞が出てこないときは个で代用できます。そのうえで、よく使う組み合わせから覚えていきましょう。",
      "example": {
        "cn": "一个问题",
        "pinyin": "yí ge wèntí",
        "ja": "1つの問題"
      }
    },
    {
      "title": "一は後ろの声調で読みが変わる",
      "body": "一は、4声の前で yí、1・2・3声の前で yì と読みます。漢字はいつも一のままです。",
      "example": {
        "cn": "一本书",
        "pinyin": "yì běn shū",
        "ja": "1冊の本"
      }
    }
  ],
  "numberPatterns": [
    {
      "level": "HSK 1",
      "title": "11〜99は十の前後に数を置く",
      "formula": "（十の位）＋ 十 ＋（一の位）",
