    {
      "level": "HSK 1",
      "title": "量詞の前の2は两",
      "formula": "两 ＋ 量詞 ＋ 名詞",
      "example": {
        "cn": "两个人",
        "pinyin": "liǎng ge rén",
        "ja": "2人"
      },
      "note": "番号・計算・十の位は二（第二、二十）、数量詞ではふつう两を使います。"
    },
    {
      "level": "HSK 2",
      "title": "順番は第を前に置く",
      "formula": "第 ＋ 数 ＋（量詞）＋ 名詞",
      "example": {
        "cn": "第三课",
        "pinyin": "dì sān kè",
        "ja": "第3課"
      },
      "note": "第一次（初めて）、第二层（2階）のように使います。この場合は第二です。"
    },
    {
      "level": "HSK 1",
      "title": "少ない数は几、広くたずねるときは多少",
      "formula": "几 ＋ 量詞 ＋ 名詞 / 多少 ＋（量詞）＋ 名詞",
      "example": {
        "cn": "你有几本书？",
        "pinyin": "Nǐ yǒu jǐ běn shū?",
        "ja": "本を何冊持っていますか。"
      },
      "note": "几の後ろは量詞を省けません。多少では量詞を省くことがあります。"
    },
    {
      "level": "HSK 3",
      "title": "「〜余り」と「〜ぐらい」",
      "formula": "数量 ＋ 多 / 数量 ＋ 左右",
      "example": {
        "cn": "三个多小时",
        "pinyin": "sān ge duō xiǎoshí",
        "ja": "3時間余り"
      },
      "note": "多は数を少し超える意味、左右は前後の幅を持たせる言い方です。"
    },
    {
      "level": "HSK 3",
