{
  "categories": [
    {
      "id": "number",
      "group": "pos",
      "label": "数詞",
      "description": "一・二・百など、数を表す語"
    },
    {
      "id": "measure",
      "group": "pos",
      "label": "量詞（助数詞）",
      "description": "个・本・张など、数を数えるときの単位"
    },
    {
      "id": "pronoun",
      "group": "pos",
      "label": "代名詞",
      "description": "我・你・这・自己など、人や物を指す語"
    },
    {
      "id": "question",
      "group": "pos",
      "label": "疑問詞",
      "description": "什么・谁・怎么など、たずねるときの語"
    },
    {
      "id": "verb",
      "group": "pos",
      "label": "動詞",
      "description": "吃・去・做など、動作や行為を表す語"
    },
    {
      "id": "adjective",
      "group": "pos",
      "label": "形容詞",
      "description": "高い・低いなど、様子や性質を表す語"
    },
    {
      "id": "adverb",
      "group": "pos",
      "label": "副詞",
      "description": "很・都・已经など、動作や様子を修飾する語"
    },
    {
      "id": "modal",
      "group": "pos",
      "label": "助動詞",
      "description": "会・能・可以・应该など、できる／すべきを表す語"
    },
    {
      "id": "preposition",
      "group": "pos",
      "label": "介詞（前置詞）",
