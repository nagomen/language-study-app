    },
    {
      "id": "conjunction",
      "group": "pos",
      "label": "接続詞",
      "description": "和・但是・因为など、文や語をつなぐ語"
    },
    {
      "id": "particle",
      "group": "pos",
      "label": "助詞・語気詞",
      "description": "的・了・吗・吧など、文法の働きをする語"
    },
    {
      "id": "degree",
      "group": "pos",
